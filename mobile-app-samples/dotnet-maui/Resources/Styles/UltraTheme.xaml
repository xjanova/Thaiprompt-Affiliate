<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        ╔══════════════════════════════════════════════════════════════════╗
        ║              THAIPROMPT ULTRA THEME                              ║
        ║              Glassmorphism + 3D Design System                   ║
        ╚══════════════════════════════════════════════════════════════════╝

        สไตล์หลักของแอพ:
        - Glassmorphism (พื้นหลังโปร่งแสง + blur)
        - 3D Effects (shadows, gradients, depth)
        - Dark/Light Mode support
        - Modern animations และ transitions
    -->

    <!-- ════════════════════════════════════════════════════════════════════
         COLOR PALETTE - โทนสีหลักของแอพ
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Primary Colors - สีหลัก -->
    <Color x:Key="UltraPrimary">#6366F1</Color>
    <Color x:Key="UltraPrimaryLight">#818CF8</Color>
    <Color x:Key="UltraPrimaryDark">#4F46E5</Color>

    <!-- Secondary Colors - สีรอง -->
    <Color x:Key="UltraSecondary">#8B5CF6</Color>
    <Color x:Key="UltraSecondaryLight">#A78BFA</Color>
    <Color x:Key="UltraSecondaryDark">#7C3AED</Color>

    <!-- Accent Colors - สีเน้น -->
    <Color x:Key="UltraAccent">#06B6D4</Color>
    <Color x:Key="UltraAccentLight">#22D3EE</Color>
    <Color x:Key="UltraAccentDark">#0891B2</Color>

    <!-- Semantic Colors - สีตามความหมาย -->
    <Color x:Key="UltraSuccess">#10B981</Color>
    <Color x:Key="UltraSuccessLight">#34D399</Color>
    <Color x:Key="UltraWarning">#F59E0B</Color>
    <Color x:Key="UltraWarningLight">#FBBF24</Color>
    <Color x:Key="UltraError">#EF4444</Color>
    <Color x:Key="UltraErrorLight">#F87171</Color>
    <Color x:Key="UltraInfo">#3B82F6</Color>

    <!-- Gradient Colors - สีสำหรับ gradient -->
    <Color x:Key="GradientStart">#6366F1</Color>
    <Color x:Key="GradientMiddle">#8B5CF6</Color>
    <Color x:Key="GradientEnd">#EC4899</Color>

    <!-- Dark Theme Colors - สีสำหรับ Dark Mode -->
    <Color x:Key="DarkBackground">#0F0F23</Color>
    <Color x:Key="DarkSurface">#1A1A2E</Color>
    <Color x:Key="DarkCard">#16213E</Color>
    <Color x:Key="DarkCardHover">#1E2A4A</Color>
    <Color x:Key="DarkText">#F8FAFC</Color>
    <Color x:Key="DarkTextSecondary">#94A3B8</Color>
    <Color x:Key="DarkBorder">#334155</Color>

    <!-- Light Theme Colors - สีสำหรับ Light Mode -->
    <Color x:Key="LightBackground">#F8FAFC</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightCard">#FFFFFF</Color>
    <Color x:Key="LightCardHover">#F1F5F9</Color>
    <Color x:Key="LightText">#0F172A</Color>
    <Color x:Key="LightTextSecondary">#64748B</Color>
    <Color x:Key="LightBorder">#E2E8F0</Color>

    <!-- Glass Effect Colors - สีสำหรับ Glassmorphism -->
    <Color x:Key="GlassWhite">#40FFFFFF</Color>
    <Color x:Key="GlassDark">#40000000</Color>
    <Color x:Key="GlassBorder">#30FFFFFF</Color>

    <!-- ════════════════════════════════════════════════════════════════════
         SPACING SYSTEM - ระบบระยะห่าง
         ════════════════════════════════════════════════════════════════════ -->

    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">16</x:Double>
    <x:Double x:Key="SpacingLG">24</x:Double>
    <x:Double x:Key="SpacingXL">32</x:Double>
    <x:Double x:Key="SpacingXXL">48</x:Double>
    <x:Double x:Key="SpacingXXXL">64</x:Double>

    <!-- ════════════════════════════════════════════════════════════════════
         BORDER RADIUS - ความโค้งมน
         ════════════════════════════════════════════════════════════════════ -->

    <x:Double x:Key="RadiusSM">8</x:Double>
    <x:Double x:Key="RadiusMD">12</x:Double>
    <x:Double x:Key="RadiusLG">16</x:Double>
    <x:Double x:Key="RadiusXL">24</x:Double>
    <x:Double x:Key="RadiusXXL">32</x:Double>
    <x:Double x:Key="RadiusFull">999</x:Double>

    <!-- ════════════════════════════════════════════════════════════════════
         TYPOGRAPHY - ขนาดตัวอักษร
         ════════════════════════════════════════════════════════════════════ -->

    <x:Double x:Key="FontSizeXS">10</x:Double>
    <x:Double x:Key="FontSizeSM">12</x:Double>
    <x:Double x:Key="FontSizeMD">14</x:Double>
    <x:Double x:Key="FontSizeLG">16</x:Double>
    <x:Double x:Key="FontSizeXL">18</x:Double>
    <x:Double x:Key="FontSizeXXL">20</x:Double>
    <x:Double x:Key="FontSizeH3">24</x:Double>
    <x:Double x:Key="FontSizeH2">28</x:Double>
    <x:Double x:Key="FontSizeH1">32</x:Double>
    <x:Double x:Key="FontSizeDisplay">40</x:Double>

    <!-- ════════════════════════════════════════════════════════════════════
         SHADOW PRESETS - เงา 3D
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Shadow สำหรับ Light mode -->
    <Shadow x:Key="ShadowSM"
            Brush="#15000000"
            Offset="0,2"
            Radius="4"
            Opacity="0.15"/>

    <Shadow x:Key="ShadowMD"
            Brush="#20000000"
            Offset="0,4"
            Radius="8"
            Opacity="0.2"/>

    <Shadow x:Key="ShadowLG"
            Brush="#25000000"
            Offset="0,8"
            Radius="16"
            Opacity="0.25"/>

    <Shadow x:Key="ShadowXL"
            Brush="#30000000"
            Offset="0,12"
            Radius="24"
            Opacity="0.3"/>

    <!-- Shadow สำหรับ Glow Effect -->
    <Shadow x:Key="GlowPrimary"
            Brush="{StaticResource UltraPrimary}"
            Offset="0,0"
            Radius="20"
            Opacity="0.5"/>

    <Shadow x:Key="GlowAccent"
            Brush="{StaticResource UltraAccent}"
            Offset="0,0"
            Radius="20"
            Opacity="0.5"/>

    <!-- ════════════════════════════════════════════════════════════════════
         GLASSMORPHISM CARD STYLES - สไตล์การ์ด
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Glass Card - Dark Mode -->
    <Style x:Key="GlassCardDark" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassDark}"/>
        <Setter Property="BorderColor" Value="{StaticResource GlassBorder}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingMD}"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <!-- Glass Card - Light Mode -->
    <Style x:Key="GlassCardLight" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassWhite}"/>
        <Setter Property="BorderColor" Value="{StaticResource GlassBorder}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingMD}"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <!-- Solid Card - Dark Mode -->
    <Style x:Key="SolidCardDark" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource DarkCard}"/>
        <Setter Property="BorderColor" Value="{StaticResource DarkBorder}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingMD}"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMD}"/>
    </Style>

    <!-- Solid Card - Light Mode -->
    <Style x:Key="SolidCardLight" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource LightCard}"/>
        <Setter Property="BorderColor" Value="{StaticResource LightBorder}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}"/>
        <Setter Property="Padding" Value="{StaticResource SpacingMD}"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMD}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         ULTRA BUTTON STYLES - สไตล์ปุ่ม 3D
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Primary Button - ปุ่มหลัก -->
    <Style x:Key="UltraPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMD}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource UltraPrimary}"/>
                            <Setter Property="Scale" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource UltraPrimaryDark}"/>
                            <Setter Property="Scale" Value="0.98"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#64748B"/>
                            <Setter Property="TextColor" Value="#94A3B8"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary Button - ปุ่มรอง -->
    <Style x:Key="UltraSecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource UltraSecondary}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowMD}"/>
    </Style>

    <!-- Outline Button - ปุ่มขอบ -->
    <Style x:Key="UltraOutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="BorderColor" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="BorderWidth" Value="2"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="HeightRequest" Value="56"/>
    </Style>

    <!-- Ghost Button - ปุ่มโปร่งใส -->
    <Style x:Key="UltraGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         HUB CARD STYLES - สไตล์ปุ่มเลือกบริการ
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Hub Card Container -->
    <Style x:Key="HubCardContainer" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource DarkCard}"/>
        <Setter Property="BorderColor" Value="{StaticResource DarkBorder}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HeightRequest" Value="140"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="Shadow" Value="{StaticResource ShadowLG}"/>
    </Style>

    <!-- Hub Card Container - Hover/Selected -->
    <Style x:Key="HubCardContainerActive" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="BorderColor" Value="{StaticResource UltraPrimaryLight}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HeightRequest" Value="140"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="Shadow" Value="{StaticResource GlowPrimary}"/>
    </Style>

    <!-- Hub Icon Style -->
    <Style x:Key="HubIconLabel" TargetType="Label">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Hub Title Style -->
    <Style x:Key="HubTitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="MaxLines" Value="2"/>
    </Style>

    <!-- Hub Subtitle Style -->
    <Style x:Key="HubSubtitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkTextSecondary}"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         TYPOGRAPHY STYLES - สไตล์ตัวอักษร
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Display Title - หัวข้อใหญ่มาก -->
    <Style x:Key="UltraDisplayTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="FontFamily" Value="OpenSansBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
        <Setter Property="LineHeight" Value="1.2"/>
    </Style>

    <!-- Heading 1 -->
    <Style x:Key="UltraH1" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="FontFamily" Value="OpenSansBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeH1}"/>
        <Setter Property="LineHeight" Value="1.2"/>
    </Style>

    <!-- Heading 2 -->
    <Style x:Key="UltraH2" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeH2}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <!-- Heading 3 -->
    <Style x:Key="UltraH3" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}"/>
        <Setter Property="LineHeight" Value="1.3"/>
    </Style>

    <!-- Body Text -->
    <Style x:Key="UltraBody" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="LineHeight" Value="1.5"/>
    </Style>

    <!-- Body Secondary -->
    <Style x:Key="UltraBodySecondary" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkTextSecondary}"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
        <Setter Property="LineHeight" Value="1.5"/>
    </Style>

    <!-- Caption -->
    <Style x:Key="UltraCaption" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource DarkTextSecondary}"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         INPUT STYLES - สไตล์ช่องกรอกข้อมูล
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Ultra Entry -->
    <Style x:Key="UltraEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource DarkText}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource DarkTextSecondary}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource DarkSurface}"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
    </Style>

    <!-- Ultra Entry Container -->
    <Style x:Key="UltraEntryContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource DarkSurface}"/>
        <Setter Property="Stroke" Value="{StaticResource DarkBorder}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12"/>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         SPLASH SCREEN STYLES - สไตล์หน้า Splash
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Splash Logo Container -->
    <Style x:Key="SplashLogoContainer" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassWhite}"/>
        <Setter Property="CornerRadius" Value="40"/>
        <Setter Property="WidthRequest" Value="160"/>
        <Setter Property="HeightRequest" Value="160"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HasShadow" Value="True"/>
        <Setter Property="Shadow" Value="{StaticResource GlowPrimary}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Splash Title -->
    <Style x:Key="SplashTitle" TargetType="Label">
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="OpenSansBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeH1}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>

    <!-- Splash Subtitle -->
    <Style x:Key="SplashSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="#B0B0B0"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>

    <!-- Loading Indicator -->
    <Style x:Key="UltraActivityIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="WidthRequest" Value="48"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         BADGE STYLES - สไตล์ป้าย
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Primary Badge -->
    <Style x:Key="UltraBadgePrimary" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UltraPrimary}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999"/>
        </Setter>
    </Style>

    <!-- Success Badge -->
    <Style x:Key="UltraBadgeSuccess" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UltraSuccess}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999"/>
        </Setter>
    </Style>

    <!-- Warning Badge -->
    <Style x:Key="UltraBadgeWarning" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UltraWarning}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999"/>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════════
         GRADIENT BACKGROUNDS - พื้นหลัง gradient
         ════════════════════════════════════════════════════════════════════ -->

    <!-- Splash Gradient Background -->
    <LinearGradientBrush x:Key="SplashGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F0F23" Offset="0.0"/>
        <GradientStop Color="#1A1A2E" Offset="0.3"/>
        <GradientStop Color="#16213E" Offset="0.6"/>
        <GradientStop Color="#0F0F23" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Primary Gradient -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStart}" Offset="0.0"/>
        <GradientStop Color="{StaticResource GradientMiddle}" Offset="0.5"/>
        <GradientStop Color="{StaticResource GradientEnd}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Accent Gradient -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource UltraAccent}" Offset="0.0"/>
        <GradientStop Color="{StaticResource UltraPrimary}" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Card Gradient Dark -->
    <LinearGradientBrush x:Key="CardGradientDark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E293B" Offset="0.0"/>
        <GradientStop Color="#0F172A" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
