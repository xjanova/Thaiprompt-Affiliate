<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TP.POS.App.ViewModels;assembly=TP.POS.App.ViewModels"
             x:Class="TP.POS.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="เข้าสู่ระบบ"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A1A">

    <Grid>
        <!-- Premium Dark Background with Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0A1A" Offset="0.0"/>
                <GradientStop Color="#1A1A2E" Offset="0.3"/>
                <GradientStop Color="#16213E" Offset="0.6"/>
                <GradientStop Color="#0F3460" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Firefly/Particle Effect Canvas - Multiple Glowing Dots -->
        <AbsoluteLayout x:Name="FireflyCanvas" InputTransparent="True">
            <!-- Firefly 1 - Large, slow -->
            <Ellipse x:Name="Firefly1" AbsoluteLayout.LayoutBounds="0.1,0.2,16,16" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#22C55E" Opacity="0"/>
            <!-- Firefly 2 -->
            <Ellipse x:Name="Firefly2" AbsoluteLayout.LayoutBounds="0.8,0.3,12,12" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#34D399" Opacity="0"/>
            <!-- Firefly 3 -->
            <Ellipse x:Name="Firefly3" AbsoluteLayout.LayoutBounds="0.3,0.7,14,14" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#10B981" Opacity="0"/>
            <!-- Firefly 4 - Small, fast -->
            <Ellipse x:Name="Firefly4" AbsoluteLayout.LayoutBounds="0.9,0.6,10,10" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#6EE7B7" Opacity="0"/>
            <!-- Firefly 5 -->
            <Ellipse x:Name="Firefly5" AbsoluteLayout.LayoutBounds="0.2,0.5,8,8" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#A7F3D0" Opacity="0"/>
            <!-- Firefly 6 - Extra glow -->
            <Ellipse x:Name="Firefly6" AbsoluteLayout.LayoutBounds="0.6,0.15,18,18" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#22C55E" Opacity="0"/>
            <!-- Firefly 7 -->
            <Ellipse x:Name="Firefly7" AbsoluteLayout.LayoutBounds="0.4,0.85,11,11" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#4ADE80" Opacity="0"/>
            <!-- Firefly 8 -->
            <Ellipse x:Name="Firefly8" AbsoluteLayout.LayoutBounds="0.7,0.45,9,9" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#86EFAC" Opacity="0"/>
            <!-- Firefly 9 - Golden accent -->
            <Ellipse x:Name="Firefly9" AbsoluteLayout.LayoutBounds="0.15,0.35,13,13" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#FBBF24" Opacity="0"/>
            <!-- Firefly 10 -->
            <Ellipse x:Name="Firefly10" AbsoluteLayout.LayoutBounds="0.85,0.8,15,15" AbsoluteLayout.LayoutFlags="PositionProportional"
                     Fill="#FCD34D" Opacity="0"/>
        </AbsoluteLayout>

        <!-- Main Content -->
        <ScrollView VerticalOptions="Center" HorizontalOptions="Center"
                    VerticalScrollBarVisibility="Never"
                    HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,10" Spacing="12"
                                 MaximumWidthRequest="400"
                                 HorizontalOptions="Center">

                <!-- Logo & Header with Glow Effect -->
                <VerticalStackLayout Spacing="8" Margin="0,5,0,5">
                    <!-- Glowing Logo Container -->
                    <Grid HorizontalOptions="Center">
                        <!-- Outer Glow Ring -->
                        <Border StrokeThickness="2" HeightRequest="80" WidthRequest="80"
                                Stroke="#22C55E" BackgroundColor="Transparent"
                                Opacity="0.3" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                        </Border>
                        <!-- Main Logo -->
                        <Border x:Name="LogoBorder" StrokeThickness="0" HeightRequest="65" WidthRequest="65"
                                BackgroundColor="#1A1A2E" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#8022C55E" Offset="0,0" Radius="20"/>
                            </Border.Shadow>
                            <Grid>
                                <!-- Inner Gradient -->
                                <Border BackgroundColor="Transparent" HeightRequest="65" WidthRequest="65">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.5" Radius="0.7">
                                            <GradientStop Color="#22C55E" Offset="0"/>
                                            <GradientStop Color="#16A34A" Offset="0.5"/>
                                            <GradientStop Color="#1A1A2E" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Label Text="TP" FontSize="28" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Label Text="TP-POS" FontSize="26" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center">
                        <Label.Shadow>
                            <Shadow Brush="#8022C55E" Offset="0,0" Radius="10"/>
                        </Label.Shadow>
                    </Label>
                    <Label Text="ระบบขายหน้าร้านครบวงจร" FontSize="13"
                           TextColor="#9CA3AF" HorizontalOptions="Center"/>

                    <!-- Shop Name (if configured) -->
                    <Border BackgroundColor="#1F2937" StrokeThickness="0" Padding="8,5"
                            IsVisible="{Binding HasShopName}" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="🏪" FontSize="12"/>
                            <Label Text="{Binding ShopName}" FontSize="12"
                                   TextColor="#22C55E" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Connection Status Indicator with Pulse -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,0,0,5">
                    <Grid>
                        <!-- Pulse Ring -->
                        <Ellipse x:Name="PulseRing" WidthRequest="20" HeightRequest="20"
                                 Stroke="#22C55E" StrokeThickness="2" Fill="Transparent" Opacity="0"/>
                        <!-- Status Dot -->
                        <Ellipse x:Name="ConnectionIndicator"
                                 WidthRequest="12" HeightRequest="12"
                                 Fill="#22C55E" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                    <Label x:Name="ConnectionStatusLabel"
                           Text="{Binding ConnectionStatusText}"
                           FontSize="13" TextColor="#9CA3AF"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Premium Glass-morphism Login Card -->
                <Border x:Name="LoginCardBorder" StrokeThickness="1" Padding="18"
                        Stroke="#334155">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1F293766" Offset="0"/>
                            <GradientStop Color="#11182788" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow x:Name="LoginCardShadow" Brush="#4022C55E" Offset="0,0" Radius="50"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="เข้าสู่ระบบ" FontSize="20" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>

                        <!-- Error Message -->
                        <Border BackgroundColor="#7F1D1D" Stroke="#EF4444" StrokeThickness="1" Padding="8"
                                IsVisible="{Binding ShowError}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="14"/>
                                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#FCA5A5"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Username Input -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ชื่อผู้ใช้" FontSize="12" TextColor="#9CA3AF"/>
                            <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border BackgroundColor="#374151" StrokeThickness="0"
                                            WidthRequest="32" HeightRequest="32">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="👤" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Entry Grid.Column="1" Text="{Binding Username}"
                                           Placeholder="ระบุชื่อผู้ใช้"
                                           PlaceholderColor="#6B7280"
                                           FontSize="14" TextColor="White"
                                           BackgroundColor="Transparent"
                                           ReturnType="Next"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Input -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="รหัสผ่าน" FontSize="12" TextColor="#9CA3AF"/>
                            <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border BackgroundColor="#374151" StrokeThickness="0"
                                            WidthRequest="32" HeightRequest="32">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Label Text="🔒" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Entry Grid.Column="1" Text="{Binding Password}"
                                           Placeholder="ระบุรหัสผ่าน"
                                           PlaceholderColor="#6B7280"
                                           IsPassword="True"
                                           FontSize="14" TextColor="White"
                                           BackgroundColor="Transparent"
                                           ReturnType="Done"
                                           ReturnCommand="{Binding LoginCommand}"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Remember Me & Forgot Password -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding RememberMe}" Color="#22C55E" Scale="0.9"/>
                                <Label Text="จำรหัสผ่าน" FontSize="12" TextColor="#9CA3AF" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="ลืมรหัสผ่าน?" FontSize="12" TextColor="#60A5FA"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- Login Button -->
                        <Button Text="🔐 เข้าสู่ระบบ"
                                BackgroundColor="#22C55E" TextColor="White"
                                FontSize="16" FontAttributes="Bold"
                                HeightRequest="45" CornerRadius="10"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding CanLogin}"/>

                        <!-- Divider -->
                        <Grid ColumnDefinitions="*,Auto,*">
                            <BoxView Grid.Column="0" HeightRequest="1" Color="#374151" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="หรือ" FontSize="12" TextColor="#6B7280" Margin="10,0"/>
                            <BoxView Grid.Column="2" HeightRequest="1" Color="#374151" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Alternative Login Options -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="🔢 PIN"
                                    BackgroundColor="#1F2937" TextColor="#9CA3AF"
                                    FontSize="14" HeightRequest="40" CornerRadius="10"
                                    BorderColor="#374151" BorderWidth="1"
                                    Command="{Binding LoginWithPinCommand}"/>
                            <Button Grid.Column="1" Text="📴 Offline"
                                    BackgroundColor="#1F2937" TextColor="#9CA3AF"
                                    FontSize="14" HeightRequest="40" CornerRadius="10"
                                    BorderColor="#374151" BorderWidth="1"
                                    Command="{Binding OfflineModeCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- First Time Setup Notice -->
                <Border BackgroundColor="#1E3A5F" Stroke="#3B82F6" StrokeThickness="1" Padding="12"
                        IsVisible="{Binding NeedsFirstTimeSetup}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="⚡" FontSize="14"/>
                            <Label Text="ยินดีต้อนรับ! ครั้งแรกใช้งาน" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        </HorizontalStackLayout>
                        <Label Text="กรุณาตั้งค่าระบบก่อนเริ่มใช้งาน" FontSize="11" TextColor="#93C5FD"/>
                        <Button Text="🚀 เริ่มตั้งค่าระบบ"
                                BackgroundColor="#3B82F6" TextColor="White"
                                FontSize="13" FontAttributes="Bold"
                                HeightRequest="38" CornerRadius="8"
                                Command="{Binding GoToSetupCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Setup Link (for configured users) -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4"
                                       IsVisible="{Binding NeedsFirstTimeSetup, Converter={StaticResource InverseBoolConverter}}">
                    <Label Text="เปลี่ยนร้าน?" FontSize="11" TextColor="#6B7280"/>
                    <Label Text="ตั้งค่าใหม่" FontSize="11" TextColor="#60A5FA" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSetupCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Device Code & Version -->
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="🖥️" FontSize="10"/>
                        <Label Text="{Binding DeviceCode}" FontSize="10" TextColor="#6B7280"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding AppVersion, StringFormat='v{0}'}"
                           FontSize="10" TextColor="#4B5563" HorizontalOptions="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Premium Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#CC0A0A1A">
            <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1"
                    HeightRequest="140" WidthRequest="220"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22C55E" Offset="0,0" Radius="30" Opacity="0.5"/>
                </Border.Shadow>
                <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                    <ActivityIndicator IsRunning="True" Color="#22C55E" HeightRequest="40" WidthRequest="40" HorizontalOptions="Center"/>
                    <Label Text="{Binding BusyMessage}" FontSize="14" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
