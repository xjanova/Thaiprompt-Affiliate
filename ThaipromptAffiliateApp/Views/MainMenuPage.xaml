<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThaipromptAffiliateApp.Views.MainMenuPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A0A">

    <Grid RowDefinitions="*,Auto">

        <!-- ============================================ -->
        <!-- LAVA LAMP ANIMATED BACKGROUND -->
        <!-- ============================================ -->
        <AbsoluteLayout x:Name="LavaLampContainer" Grid.RowSpan="2">
            <!-- Base Dark Background -->
            <BoxView AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"
                     Color="#0A0A0A"/>

            <!-- Lava Blob 1 - Large Gold -->
            <Frame x:Name="LavaBlob1"
                   AbsoluteLayout.LayoutBounds="0.2,0.3,180,180"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   CornerRadius="90"
                   BorderColor="Transparent"
                   Padding="0"
                   HasShadow="False"
                   Opacity="0.4">
                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#D4AF37" Offset="0.0"/>
                        <GradientStop Color="#B8941E" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>

            <!-- Lava Blob 2 - Medium Red -->
            <Frame x:Name="LavaBlob2"
                   AbsoluteLayout.LayoutBounds="0.7,0.6,150,150"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   CornerRadius="75"
                   BorderColor="Transparent"
                   Padding="0"
                   HasShadow="False"
                   Opacity="0.35">
                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#DC143C" Offset="0.0"/>
                        <GradientStop Color="#A01028" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>

            <!-- Lava Blob 3 - Small Gold -->
            <Frame x:Name="LavaBlob3"
                   AbsoluteLayout.LayoutBounds="0.8,0.2,120,120"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   CornerRadius="60"
                   BorderColor="Transparent"
                   Padding="0"
                   HasShadow="False"
                   Opacity="0.3">
                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#F1D95C" Offset="0.0"/>
                        <GradientStop Color="#D4AF37" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>

            <!-- Lava Blob 4 - Large Red Bottom -->
            <Frame x:Name="LavaBlob4"
                   AbsoluteLayout.LayoutBounds="0.3,0.75,200,200"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   CornerRadius="100"
                   BorderColor="Transparent"
                   Padding="0"
                   HasShadow="False"
                   Opacity="0.25">
                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#DC143C" Offset="0.0"/>
                        <GradientStop Color="#A01028" Offset="0.4"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>

            <!-- Lava Blob 5 - Small Floating Gold -->
            <Frame x:Name="LavaBlob5"
                   AbsoluteLayout.LayoutBounds="0.15,0.55,90,90"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   CornerRadius="45"
                   BorderColor="Transparent"
                   Padding="0"
                   HasShadow="False"
                   Opacity="0.4">
                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#D4AF37" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>

            <!-- Lava Blob 6 - Tiny Accent -->
            <Frame x:Name="LavaBlob6"
                   AbsoluteLayout.LayoutBounds="0.6,0.85,70,70"
                   AbsoluteLayout.LayoutFlags="PositionProportional"
                   CornerRadius="35"
                   BorderColor="Transparent"
                   Padding="0"
                   HasShadow="False"
                   Opacity="0.35">
                <Frame.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#F1D95C" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Frame.Background>
            </Frame>
        </AbsoluteLayout>

        <!-- ============================================ -->
        <!-- MAIN CONTENT -->
        <!-- ============================================ -->
        <ScrollView Grid.Row="0" Padding="20">
            <VerticalStackLayout Spacing="25">

                <!-- Header Section -->
                <VerticalStackLayout Spacing="8" Margin="0,40,0,20">

                    <!-- Logo with Glow -->
                    <Frame Padding="0"
                           CornerRadius="50"
                           BorderColor="#D4AF37"
                           Background="Transparent"
                           HasShadow="True"
                           WidthRequest="100"
                           HeightRequest="100"
                           HorizontalOptions="Center">
                        <Frame.Shadow>
                            <Shadow Brush="#D4AF37"
                                    Offset="0,0"
                                    Radius="30"
                                    Opacity="0.6"/>
                        </Frame.Shadow>
                        <Frame Padding="15"
                               CornerRadius="47"
                               HasShadow="False">
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D4AF37" Offset="0.0"/>
                                    <GradientStop Color="#DC143C" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                            <Label Text="TP"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                    </Frame>

                    <!-- App Title -->
                    <Label Text="THAIPROMPT"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#D4AF37"
                           HorizontalOptions="Center"
                           CharacterSpacing="3"/>

                    <Label Text="AFFILIATE CONTROL CENTER"
                           FontSize="11"
                           TextColor="#DC143C"
                           HorizontalOptions="Center"
                           CharacterSpacing="2"
                           Opacity="0.9"/>
                </VerticalStackLayout>

                <!-- ============================================ -->
                <!-- PREMIUM MENU GRID -->
                <!-- ============================================ -->
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="15"
                      RowSpacing="15">

                    <!-- 🛒 Shopping Button -->
                    <Frame Grid.Row="0" Grid.Column="0"
                           x:Name="BtnShopping"
                           Padding="0"
                           CornerRadius="20"
                           BorderColor="Transparent"
                           HasShadow="True"
                           HeightRequest="140">
                        <Frame.Shadow>
                            <Shadow Brush="#D4AF37"
                                    Offset="0,4"
                                    Radius="15"
                                    Opacity="0.3"/>
                        </Frame.Shadow>
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F1F1F" Offset="0.0"/>
                                <GradientStop Color="#2A2A2A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShoppingTapped"/>
                        </Frame.GestureRecognizers>

                        <Grid Padding="15">
                            <!-- Glass Overlay -->
                            <BoxView CornerRadius="15"
                                     Opacity="0.1"
                                     VerticalOptions="Start"
                                     HeightRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Frame WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BorderColor="Transparent"
                                       HorizontalOptions="Center">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#D4AF37" Offset="0.0"/>
                                            <GradientStop Color="#B8941E" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label Text="🛒"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="ช๊อปปิ้ง"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="สินค้าและบริการ"
                                       FontSize="10"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Gold Border Accent -->
                            <BoxView HeightRequest="3"
                                     CornerRadius="2"
                                     VerticalOptions="End"
                                     HorizontalOptions="Center"
                                     WidthRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00D4AF37" Offset="0.0"/>
                                        <GradientStop Color="#D4AF37" Offset="0.5"/>
                                        <GradientStop Color="#00D4AF37" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>
                    </Frame>

                    <!-- 📊 Dashboard Button -->
                    <Frame Grid.Row="0" Grid.Column="1"
                           x:Name="BtnDashboard"
                           Padding="0"
                           CornerRadius="20"
                           BorderColor="Transparent"
                           HasShadow="True"
                           HeightRequest="140">
                        <Frame.Shadow>
                            <Shadow Brush="#DC143C"
                                    Offset="0,4"
                                    Radius="15"
                                    Opacity="0.3"/>
                        </Frame.Shadow>
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F1F1F" Offset="0.0"/>
                                <GradientStop Color="#2A2A2A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                        </Frame.GestureRecognizers>

                        <Grid Padding="15">
                            <BoxView CornerRadius="15"
                                     Opacity="0.1"
                                     VerticalOptions="Start"
                                     HeightRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Frame WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BorderColor="Transparent"
                                       HorizontalOptions="Center">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#DC143C" Offset="0.0"/>
                                            <GradientStop Color="#A01028" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label Text="📊"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="แดชบอร์ด"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="ภาพรวมและสถิติ"
                                       FontSize="10"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="3"
                                     CornerRadius="2"
                                     VerticalOptions="End"
                                     HorizontalOptions="Center"
                                     WidthRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00DC143C" Offset="0.0"/>
                                        <GradientStop Color="#DC143C" Offset="0.5"/>
                                        <GradientStop Color="#00DC143C" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>
                    </Frame>

                    <!-- 💰 Commission Button -->
                    <Frame Grid.Row="1" Grid.Column="0"
                           x:Name="BtnCommission"
                           Padding="0"
                           CornerRadius="20"
                           BorderColor="Transparent"
                           HasShadow="True"
                           HeightRequest="140">
                        <Frame.Shadow>
                            <Shadow Brush="#F1D95C"
                                    Offset="0,4"
                                    Radius="15"
                                    Opacity="0.3"/>
                        </Frame.Shadow>
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F1F1F" Offset="0.0"/>
                                <GradientStop Color="#2A2A2A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCommissionTapped"/>
                        </Frame.GestureRecognizers>

                        <Grid Padding="15">
                            <BoxView CornerRadius="15"
                                     Opacity="0.1"
                                     VerticalOptions="Start"
                                     HeightRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Frame WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BorderColor="Transparent"
                                       HorizontalOptions="Center">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F1D95C" Offset="0.0"/>
                                            <GradientStop Color="#D4AF37" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label Text="💰"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="คอมมิชชั่น"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="รายได้และผลตอบแทน"
                                       FontSize="10"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="3"
                                     CornerRadius="2"
                                     VerticalOptions="End"
                                     HorizontalOptions="Center"
                                     WidthRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00F1D95C" Offset="0.0"/>
                                        <GradientStop Color="#F1D95C" Offset="0.5"/>
                                        <GradientStop Color="#00F1D95C" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>
                    </Frame>

                    <!-- 👥 Referral Button -->
                    <Frame Grid.Row="1" Grid.Column="1"
                           x:Name="BtnReferral"
                           Padding="0"
                           CornerRadius="20"
                           BorderColor="Transparent"
                           HasShadow="True"
                           HeightRequest="140">
                        <Frame.Shadow>
                            <Shadow Brush="#10B981"
                                    Offset="0,4"
                                    Radius="15"
                                    Opacity="0.3"/>
                        </Frame.Shadow>
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F1F1F" Offset="0.0"/>
                                <GradientStop Color="#2A2A2A" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReferralTapped"/>
                        </Frame.GestureRecognizers>

                        <Grid Padding="15">
                            <BoxView CornerRadius="15"
                                     Opacity="0.1"
                                     VerticalOptions="Start"
                                     HeightRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Frame WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BorderColor="Transparent"
                                       HorizontalOptions="Center">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0.0"/>
                                            <GradientStop Color="#059669" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label Text="👥"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="ผู้แนะนำ"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="เครือข่ายทีมงาน"
                                       FontSize="10"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="3"
                                     CornerRadius="2"
                                     VerticalOptions="End"
                                     HorizontalOptions="Center"
                                     WidthRequest="60">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0010B981" Offset="0.0"/>
                                        <GradientStop Color="#10B981" Offset="0.5"/>
                                        <GradientStop Color="#0010B981" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>
                    </Frame>

                    <!-- 🤖 AI Bot - Coming Soon -->
                    <Frame Grid.Row="2" Grid.Column="0"
                           Padding="0"
                           CornerRadius="20"
                           BorderColor="Transparent"
                           HasShadow="True"
                           HeightRequest="140"
                           Opacity="0.6">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A1A1A" Offset="0.0"/>
                                <GradientStop Color="#252525" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Frame.Background>

                        <Grid Padding="15">
                            <!-- Coming Soon Badge -->
                            <Frame CornerRadius="8"
                                   Padding="6,3"
                                   BorderColor="Transparent"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Margin="0,-5,-5,0">
                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D4AF37" Offset="0.0"/>
                                        <GradientStop Color="#DC143C" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <Label Text="SOON"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Frame>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Frame WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BorderColor="#3A3A3A"
                                       BackgroundColor="#2A2A2A"
                                       HorizontalOptions="Center">
                                    <Label Text="🤖"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="AI Bot"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#666666"
                                       HorizontalOptions="Center"/>
                                <Label Text="ผู้ช่วยอัจฉริยะ"
                                       FontSize="10"
                                       TextColor="#555555"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                    <!-- 🎮 Game - Coming Soon -->
                    <Frame Grid.Row="2" Grid.Column="1"
                           Padding="0"
                           CornerRadius="20"
                           BorderColor="Transparent"
                           HasShadow="True"
                           HeightRequest="140"
                           Opacity="0.6">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A1A1A" Offset="0.0"/>
                                <GradientStop Color="#252525" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Frame.Background>

                        <Grid Padding="15">
                            <!-- Coming Soon Badge -->
                            <Frame CornerRadius="8"
                                   Padding="6,3"
                                   BorderColor="Transparent"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Margin="0,-5,-5,0">
                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#D4AF37" Offset="0.0"/>
                                        <GradientStop Color="#DC143C" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <Label Text="SOON"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </Frame>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                                <Frame WidthRequest="50"
                                       HeightRequest="50"
                                       CornerRadius="25"
                                       Padding="0"
                                       BorderColor="#3A3A3A"
                                       BackgroundColor="#2A2A2A"
                                       HorizontalOptions="Center">
                                    <Label Text="🎮"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Game Center"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#666666"
                                       HorizontalOptions="Center"/>
                                <Label Text="เกมและกิจกรรม"
                                       FontSize="10"
                                       TextColor="#555555"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>

                </Grid>

                <!-- Version Info -->
                <Label Text="Premium Edition v1.0.0"
                       FontSize="10"
                       TextColor="#555555"
                       HorizontalOptions="Center"
                       Margin="0,10,0,100"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============================================ -->
        <!-- PREMIUM 3D BOTTOM NAVIGATION BAR -->
        <!-- ============================================ -->
        <Grid Grid.Row="1" Padding="15,0,15,20">
            <!-- Glass Background -->
            <Frame Padding="0"
                   CornerRadius="25"
                   BorderColor="Transparent"
                   HasShadow="True"
                   HeightRequest="70">
                <Frame.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,-5"
                            Radius="20"
                            Opacity="0.5"/>
                </Frame.Shadow>
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A2A2A" Offset="0.0"/>
                        <GradientStop Color="#1A1A1A" Offset="0.5"/>
                        <GradientStop Color="#0F0F0F" Offset="1.0"/>
                    </LinearGradientBrush>
                </Frame.Background>

                <!-- Inner Glow Top -->
                <Grid>
                    <BoxView HeightRequest="1"
                             VerticalOptions="Start"
                             Margin="20,0">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D4AF37" Offset="0.0"/>
                                <GradientStop Color="#D4AF37" Offset="0.5"/>
                                <GradientStop Color="#00D4AF37" Offset="1.0"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Navigation Items -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="30">

                        <!-- Home Button -->
                        <Frame x:Name="NavHome"
                               WidthRequest="50"
                               HeightRequest="50"
                               CornerRadius="25"
                               Padding="0"
                               BorderColor="Transparent"
                               HasShadow="True">
                            <Frame.Shadow>
                                <Shadow Brush="#D4AF37"
                                        Offset="0,2"
                                        Radius="8"
                                        Opacity="0.4"/>
                            </Frame.Shadow>
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D4AF37" Offset="0.0"/>
                                    <GradientStop Color="#B8941E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNavHomeTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="🏠"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Wallet Button -->
                        <Frame x:Name="NavWallet"
                               WidthRequest="45"
                               HeightRequest="45"
                               CornerRadius="22"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNavWalletTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="💎"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Notification Button -->
                        <Frame x:Name="NavNotification"
                               WidthRequest="45"
                               HeightRequest="45"
                               CornerRadius="22"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNavNotificationTapped"/>
                            </Frame.GestureRecognizers>
                            <Grid>
                                <Label Text="🔔"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <!-- Notification Badge -->
                                <Frame WidthRequest="16"
                                       HeightRequest="16"
                                       CornerRadius="8"
                                       Padding="0"
                                       BorderColor="Transparent"
                                       BackgroundColor="#DC143C"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start"
                                       Margin="0,-3,-3,0">
                                    <Label Text="3"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </Grid>
                        </Frame>

                        <!-- Profile Button -->
                        <Frame x:Name="NavProfile"
                               WidthRequest="45"
                               HeightRequest="45"
                               CornerRadius="22"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNavProfileTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="👤"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Settings Button -->
                        <Frame x:Name="NavSettings"
                               WidthRequest="45"
                               HeightRequest="45"
                               CornerRadius="22"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNavSettingsTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="⚙️"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                    </HorizontalStackLayout>
                </Grid>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
