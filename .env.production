APP_NAME="TP-Affiliate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Cache Configuration
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Performance Optimization
OCTANE_SERVER=swoole
FILESYSTEM_CLOUD=s3

# Security
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=your-domain.com

# Cloudflare Turnstile (Security)
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_BYPASS_ADMIN=true
CLOUDFLARE_TURNSTILE_THEME=auto
CLOUDFLARE_TURNSTILE_SIZE=normal

# Turnstile Points (Enable/Disable per endpoint)
CLOUDFLARE_TURNSTILE_LOGIN=true
CLOUDFLARE_TURNSTILE_REGISTER=true
CLOUDFLARE_TURNSTILE_PASSWORD_CHANGE=true
CLOUDFLARE_TURNSTILE_PROFILE_UPDATE=true
CLOUDFLARE_TURNSTILE_WITHDRAWAL=true
CLOUDFLARE_TURNSTILE_AFFILIATE_APP=true

# Rate Limiting & Anti-Abuse
RATE_LIMITING_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=15
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=30
RATE_LIMIT_API_DEFAULT=60
RATE_LIMIT_API_AUTHENTICATED=120
RATE_LIMIT_API_GUEST=30
RATE_LIMIT_WITHDRAWAL_MAX_ATTEMPTS=3
RATE_LIMIT_WITHDRAWAL_DECAY_MINUTES=60
RATE_LIMIT_PASSWORD_CHANGE_MAX_ATTEMPTS=3
RATE_LIMIT_PASSWORD_CHANGE_DECAY_MINUTES=60
TRACK_FAILED_LOGINS=true
FAILED_LOGIN_RETENTION_DAYS=30
