<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ThaipromptAffiliateApp.ViewModels"
             x:Class="ThaipromptAffiliateApp.Views.WebViewPage"
             x:DataType="vm:WebViewViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="{DynamicResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header with Gradient -->
        <Frame Grid.Row="0"
               CornerRadius="0,0,30,30"
               Padding="0"
               HasShadow="True"
               HeightRequest="120"
               Background="{DynamicResource PrimaryGradient}">

            <Grid Padding="20,40,20,20" RowDefinitions="Auto,Auto">

                <!-- Logo and Title -->
                <HorizontalStackLayout Grid.Row="0" Spacing="15" VerticalOptions="Center">
                    <Image Source="{Binding LogoUrl}"
                           HeightRequest="50"
                           WidthRequest="50"
                           Aspect="AspectFit"
                           IsVisible="{Binding HasLogo}"/>

                    <Label Text="{Binding AppName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Navigation Buttons -->
                <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="0,10,0,0">
                    <Button Text="◀"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            FontSize="16"
                            Padding="0"/>

                    <Button Text="▶"
                            Command="{Binding GoForwardCommand}"
                            IsEnabled="{Binding CanGoForward}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            FontSize="16"
                            Padding="0"/>

                    <Button Text="🔄"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            FontSize="16"
                            Padding="0"/>

                    <Button Text="🏠"
                            Command="{Binding GoHomeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            BorderColor="{DynamicResource BorderColor}"
                            BorderWidth="2"
                            CornerRadius="20"
                            WidthRequest="40"
                            HeightRequest="40"
                            FontSize="16"
                            Padding="0"/>
                </HorizontalStackLayout>

            </Grid>
        </Frame>

        <!-- WebView -->
        <WebView Grid.Row="1"
                 x:Name="WebViewControl"
                 Source="{Binding CurrentUrl}"
                 Navigated="OnNavigated"
                 Navigating="OnNavigating"
                 BackgroundColor="{DynamicResource BackgroundColor}"/>

        <!-- Loading Indicator -->
        <Frame Grid.Row="1"
               IsVisible="{Binding IsLoading}"
               BackgroundColor="#AA000000"
               Padding="0"
               CornerRadius="0"
               HasShadow="False">
            <VerticalStackLayout HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Spacing="20">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                 Color="{DynamicResource PrimaryColor}"
                                 WidthRequest="60"
                                 HeightRequest="60"/>

                <Label Text="กำลังโหลด..."
                       TextColor="White"
                       FontSize="16"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>

        <!-- Bottom Navigation -->
        <Frame Grid.Row="2"
               CornerRadius="30,30,0,0"
               Padding="20,15"
               HasShadow="True"
               Background="{DynamicResource CardBackground}"
               BorderColor="{DynamicResource BorderColor}">

            <ScrollView Orientation="Horizontal"
                       HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="15"
                                     BindableLayout.ItemsSource="{Binding QuickLinks}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15,10"
                                   CornerRadius="20"
                                   Background="{DynamicResource PrimaryGradient}"
                                   HasShadow="False"
                                   BorderColor="{DynamicResource BorderColor}"
                                   BorderWidth="1">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WebViewViewModel}}, Path=NavigateToCommand}"
                                                        CommandParameter="{Binding Url}"/>
                                </Frame.GestureRecognizers>

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Icon}"
                                           FontSize="20"
                                           VerticalOptions="Center"/>

                                    <Label Text="{Binding Title}"
                                           TextColor="White"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>

                                    <Frame IsVisible="{Binding HasBadge}"
                                           Padding="6,2"
                                           CornerRadius="10"
                                           BackgroundColor="{DynamicResource SecondaryColor}"
                                           HasShadow="False"
                                           VerticalOptions="Center">
                                        <Label Text="{Binding Badge}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold"/>
                                    </Frame>
                                </HorizontalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </Frame>

    </Grid>

</ContentPage>
