# TPIX Blockchain Configuration
# Copy this file to .env and fill in your values

# ============================================
# Network Configuration
# ============================================

# Local Development
TPIX_RPC_URL=http://localhost:8545
TPIX_CHAIN_ID=7000

# Testnet (Optional)
TPIX_TESTNET_RPC_URL=http://testnet.tpix.com:8545
TPIX_TESTNET_CHAIN_ID=7001

# ============================================
# Private Keys
# ============================================
# ⚠️ NEVER COMMIT THESE TO GIT!

# Deployer Private Key (Must have TPIX for deployment)
PRIVATE_KEY=

# Testnet Private Key (Optional)
TESTNET_PRIVATE_KEY=

# ============================================
# Block Explorer Configuration
# ============================================

# Explorer URLs
TPIX_EXPLORER_URL=http://explorer.tpix.com
TPIX_EXPLORER_API_URL=http://explorer.tpix.com/api

# Explorer API Key (for verification)
TPIX_EXPLORER_API_KEY=

# ============================================
# External APIs
# ============================================

# CoinMarketCap (for gas reporting)
COINMARKETCAP_API_KEY=

# ============================================
# Development Settings
# ============================================

# Enable gas reporting
REPORT_GAS=false

# Deploy to network
DEPLOY_NETWORK=localhost

# ============================================
# Contract Addresses (Auto-filled after deployment)
# ============================================

TPIX_TOKEN_ADDRESS=
TPIX_DEX_FACTORY_ADDRESS=
TPIX_DEX_ROUTER_ADDRESS=
TPIX_WETH_ADDRESS=
TPIX_PAIR_ADDRESS=
