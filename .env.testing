APP_NAME="TP-Affiliate Testing"
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:test1234567890testkey1234567890==

# Database - MySQL (ใช้ทั้ง CI และ local ที่มี MySQL)
# CI: GitHub Actions MySQL service (testing:root:password)
# Local: Laragon MySQL (testing:root:ว่าง)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=testing
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

BROADCAST_CONNECTION=null
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
FORCE_HTTPS=false
