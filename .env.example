APP_NAME="TP-Affiliate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database - MySQL (Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thaiprompt_affiliate
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache Driver (file, database, redis, memcached)
CACHE_DRIVER=file
CACHE_PREFIX=tp_affiliate_cache

# Queue (sync, database, redis, beanstalkd, sqs)
QUEUE_CONNECTION=sync

# Redis (Optional - for high performance caching)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Memcached (Optional - alternative high performance caching)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null
MEMCACHED_PERSISTENT_ID=

# Mail (Optional)
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@tp-affiliate.local"
MAIL_FROM_NAME="${APP_NAME}"

# Email Delivery System
EMAIL_DEFAULT_PROVIDER=smtp
EMAIL_TRACKING_ENABLED=true
EMAIL_TRACK_OPENS=true
EMAIL_TRACK_CLICKS=true
EMAIL_RETRY_ENABLED=true
EMAIL_MAX_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=60
EMAIL_RATE_LIMIT_ENABLED=true
EMAIL_MAX_PER_HOUR=100
EMAIL_MAX_PER_DAY=1000
EMAIL_HEALTH_CHECK_ENABLED=true
EMAIL_HEALTH_CHECK_INTERVAL=3600

# Google Gmail API (Recommended for high volume)
GMAIL_API_ENABLED=false
GMAIL_API_CREDENTIALS_PATH=storage/app/gmail-credentials.json
GMAIL_API_CREDENTIALS_JSON=
GMAIL_API_USER_EMAIL=
GMAIL_API_ACCESS_TOKEN=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_REDIRECT_URI="${APP_URL}/admin/email/gmail/callback"
GMAIL_API_FROM_EMAIL=
GMAIL_API_FROM_NAME="${APP_NAME}"
GMAIL_API_DAILY_LIMIT=500

# Google Gmail SMTP (Alternative to API - requires App Password)
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_ENCRYPTION=tls
GMAIL_SMTP_FROM_EMAIL=
GMAIL_SMTP_FROM_NAME="${APP_NAME}"
GMAIL_SMTP_DAILY_LIMIT=500
GMAIL_SMTP_HOURLY_LIMIT=100

# Generic SMTP
SMTP_ENABLED=true
SMTP_AUTH=true

# Google Translate API (Optional)
GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_TRANSLATE_CREDENTIALS=storage/app/google-credentials.json

# Translation Settings
TRANSLATE_CACHE_ENABLED=true
TRANSLATE_CACHE_TTL=86400
TRANSLATE_SOURCE_LANGUAGE=th

# Cloudflare Turnstile (Security)
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_BYPASS_ADMIN=true
CLOUDFLARE_TURNSTILE_THEME=auto
CLOUDFLARE_TURNSTILE_SIZE=normal

# Turnstile Points (Enable/Disable per endpoint)
CLOUDFLARE_TURNSTILE_LOGIN=true
CLOUDFLARE_TURNSTILE_REGISTER=true
CLOUDFLARE_TURNSTILE_PASSWORD_CHANGE=true
CLOUDFLARE_TURNSTILE_PROFILE_UPDATE=true
CLOUDFLARE_TURNSTILE_WITHDRAWAL=true
CLOUDFLARE_TURNSTILE_AFFILIATE_APP=true

# Rate Limiting & Anti-Abuse
RATE_LIMITING_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=15
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=30
RATE_LIMIT_API_DEFAULT=60
RATE_LIMIT_API_AUTHENTICATED=120
RATE_LIMIT_API_GUEST=30
RATE_LIMIT_WITHDRAWAL_MAX_ATTEMPTS=3
RATE_LIMIT_WITHDRAWAL_DECAY_MINUTES=60
RATE_LIMIT_PASSWORD_CHANGE_MAX_ATTEMPTS=3
RATE_LIMIT_PASSWORD_CHANGE_DECAY_MINUTES=60
TRACK_FAILED_LOGINS=true
FAILED_LOGIN_RETENTION_DAYS=30

# Auto-Ban System
AUTO_BAN_ENABLED=true

# Auto-Ban Rules
AUTO_BAN_FAILED_LOGIN_ENABLED=true
AUTO_BAN_FAILED_LOGIN_THRESHOLD=10
AUTO_BAN_FAILED_LOGIN_TIME_WINDOW=30
AUTO_BAN_FAILED_LOGIN_BAN_DURATION=1440

AUTO_BAN_TURNSTILE_ENABLED=true
AUTO_BAN_TURNSTILE_THRESHOLD=15
AUTO_BAN_TURNSTILE_TIME_WINDOW=60
AUTO_BAN_TURNSTILE_BAN_DURATION=720

AUTO_BAN_RATE_LIMIT_ENABLED=true
AUTO_BAN_RATE_LIMIT_THRESHOLD=20
AUTO_BAN_RATE_LIMIT_TIME_WINDOW=60
AUTO_BAN_RATE_LIMIT_BAN_DURATION=480

AUTO_BAN_SUSPICIOUS_ENABLED=true
AUTO_BAN_SUSPICIOUS_THRESHOLD=25
AUTO_BAN_SUSPICIOUS_TIME_WINDOW=120
AUTO_BAN_SUSPICIOUS_BAN_DURATION=2880

# Auto-Ban Notifications
AUTO_BAN_NOTIFICATIONS_ENABLED=true
AUTO_BAN_EMAIL_ENABLED=true
AUTO_BAN_EMAIL_RECIPIENTS=admin@example.com
AUTO_BAN_SLACK_ENABLED=false
AUTO_BAN_SLACK_WEBHOOK=

# IP Intelligence API (Optional)
PROXYCHECK_API_KEY=

# Developer Mode (IP-locked Developer Features)
# Enable developer-only features like Release Manager
DEV_MODE_ENABLED=false
# Comma-separated list of whitelisted developer IPs
# Example: DEV_WHITELIST_IPS=123.456.789.0,98.765.432.1
DEV_WHITELIST_IPS=

# =============================================================================
# TPIX BLOCKCHAIN & TOKEN SYSTEM CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# TPIX Blockchain Network
# -----------------------------------------------------------------------------
TPIX_RPC_URL=http://localhost:8545
TPIX_WS_URL=ws://localhost:8546
TPIX_CHAIN_ID=7000
TPIX_EXPLORER_URL=http://localhost:4000
TPIX_CONFIRMATIONS=5
TPIX_IS_TESTNET=false

# TPIX Native Coin
TPIX_INITIAL_PRICE_USD=0.10

# -----------------------------------------------------------------------------
# TPIX Admin Wallet (IMPORTANT: Keep secure!)
# -----------------------------------------------------------------------------
TPIX_ADMIN_WALLET_ADDRESS=
TPIX_ADMIN_PRIVATE_KEY=
TPIX_FEE_COLLECTION_ADDRESS=
TPIX_TREASURY_ADDRESS=

# -----------------------------------------------------------------------------
# Token Creation Settings
# -----------------------------------------------------------------------------
TPIX_TOKEN_CREATION_FEE=100
TPIX_TOKEN_DEPLOYMENT_FEE=50
TPIX_TOKEN_VERIFICATION_FEE=200
TPIX_MAX_TOKENS_PER_USER=10
TPIX_MAX_TOKENS_PER_DAY=5

# -----------------------------------------------------------------------------
# DEX (Decentralized Exchange) Settings
# -----------------------------------------------------------------------------
TPIX_DEX_FACTORY_ADDRESS=
TPIX_DEX_ROUTER_ADDRESS=
TPIX_DEX_INIT_CODE_HASH=
TPIX_DEX_SWAP_FEE=0.3
TPIX_DEX_PROTOCOL_FEE=0.05
TPIX_DEX_DEFAULT_SLIPPAGE=0.5
TPIX_DEX_MAX_SLIPPAGE=50
TPIX_DEX_PRICE_IMPACT_WARNING=5
TPIX_DEX_PRICE_IMPACT_CRITICAL=15
TPIX_DEX_POOL_CREATION_FEE=10
TPIX_DEX_ALLOW_PUBLIC_POOLS=true
TPIX_DEX_ENABLE_FLASH_SWAPS=false
TPIX_DEX_ENABLE_LIMIT_ORDERS=false
TPIX_DEX_ENABLE_FARMING=false

# -----------------------------------------------------------------------------
# Staking Settings
# -----------------------------------------------------------------------------
TPIX_STAKING_MIN_AMOUNT=1
TPIX_STAKING_MAX_POOLS=5
TPIX_STAKING_POOL_FEE=50
TPIX_STAKING_MIN_APY=5
TPIX_STAKING_MAX_APY=200
TPIX_STAKING_REWARD_INTERVAL=3600
TPIX_STAKING_COMPOUND_ENABLED=true
TPIX_STAKING_AUTO_COMPOUND_FEE=0.1
TPIX_STAKING_EARLY_PENALTY=10

# -----------------------------------------------------------------------------
# Referral System
# -----------------------------------------------------------------------------
TPIX_REFERRAL_REFERRER_REWARD=5
TPIX_REFERRAL_REFEREE_REWARD=2
TPIX_REFERRAL_MAX_REWARD=1000
TPIX_REFERRAL_CODE_EXPIRY=0
TPIX_REFERRAL_MAX_USES=0
TPIX_REFERRAL_REQUIRE_EMAIL=true
TPIX_REFERRAL_REQUIRE_SMS=false
TPIX_REFERRAL_MAX_PER_USER=0
TPIX_REFERRAL_MIN_TX=10

# -----------------------------------------------------------------------------
# CoinMarketCap Integration
# -----------------------------------------------------------------------------
COINMARKETCAP_API_KEY=
COINMARKETCAP_SANDBOX=false
COINMARKETCAP_DAILY_LIMIT=333
TPIX_CMC_AUTO_SYNC=true
TPIX_CMC_SYNC_INTERVAL=5

# -----------------------------------------------------------------------------
# Coin Control (Mint/Burn/Freeze)
# -----------------------------------------------------------------------------
TPIX_COIN_CONTROL_REQUIRE_APPROVAL=true
TPIX_COIN_CONTROL_MAX_MINT_DAILY=1000000
TPIX_COIN_CONTROL_MAX_BURN_DAILY=1000000
TPIX_COIN_CONTROL_REQUIRE_2FA=true
TPIX_COIN_CONTROL_MINT_COOLDOWN=24
TPIX_COIN_CONTROL_BURN_COOLDOWN=24

# -----------------------------------------------------------------------------
# Transaction Settings
# -----------------------------------------------------------------------------
TPIX_DEFAULT_GAS_LIMIT=300000
TPIX_DEFAULT_GAS_PRICE=1000000000
TPIX_GAS_PRICE_MULTIPLIER=1.1
TPIX_TX_TIMEOUT=300

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
TPIX_REQUIRE_PIN=false
TPIX_REQUIRE_2FA=false
TPIX_LARGE_AMOUNT=10000
TPIX_FRAUD_DETECTION=true
TPIX_REQUIRE_CONTRACT_VERIFICATION=true

# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
TPIX_CACHE_ENABLED=true
TPIX_CACHE_DRIVER=redis

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
TPIX_ENABLE_SMS_NOTIFICATIONS=false
TPIX_ENABLE_PUSH_NOTIFICATIONS=false
TPIX_NOTIFY_LARGE_TRANSFERS=10000

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
TPIX_API_DEBUG=false

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
TPIX_FEATURE_TOKEN_CREATION=true
TPIX_FEATURE_DEX_TRADING=true
TPIX_FEATURE_STAKING=true
TPIX_FEATURE_REFERRALS=true
TPIX_FEATURE_CMC=true
TPIX_FEATURE_COIN_CONTROL=true
TPIX_FEATURE_NFT=false
TPIX_FEATURE_GOVERNANCE=false
TPIX_FEATURE_BRIDGE=false

# -----------------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------------
TPIX_MAINTENANCE_MODE=false

# =============================================================================
# FOOD PASSPORT SYSTEM - TPIX Blockchain Integration
# =============================================================================

# -----------------------------------------------------------------------------
# Food Passport Smart Contract Addresses
# -----------------------------------------------------------------------------
TPIX_CONTRACT_FOOD_PASSPORT_NFT=
TPIX_CONTRACT_QUALITY_CERTIFICATE_NFT=
TPIX_CONTRACT_CARBON_CREDIT_TOKEN=
TPIX_CONTRACT_JOURNEY_RECORD=
TPIX_CONTRACT_QUALITY_RECORD=

# -----------------------------------------------------------------------------
# IPFS Configuration (for NFT metadata storage)
# -----------------------------------------------------------------------------
IPFS_GATEWAY_URL=https://ipfs.io
IPFS_API_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=
IPFS_PIN_TO_PINATA=true

# -----------------------------------------------------------------------------
# Food Passport Features
# -----------------------------------------------------------------------------
FOOD_PASSPORT_AUTO_BLOCKCHAIN_RECORD=true
FOOD_PASSPORT_QR_CODE_ENABLED=true
FOOD_PASSPORT_NFT_MINTING=true
FOOD_PASSPORT_CARBON_TRACKING=true

# -----------------------------------------------------------------------------
# Carbon Credit System
# -----------------------------------------------------------------------------
CARBON_CREDIT_ISSUANCE_ENABLED=true
CARBON_CREDIT_TRADING_ENABLED=true
CARBON_CREDIT_PLATFORM_COMMISSION=0.05
CARBON_CREDIT_MIN_TRADE_AMOUNT=1.0

# -----------------------------------------------------------------------------
# Google Maps API (for location tracking)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING_ENABLED=true
GOOGLE_MAPS_DIRECTIONS_ENABLED=true
GOOGLE_MAPS_CACHE_TTL=86400

# -----------------------------------------------------------------------------
# Quality Control Standards
# -----------------------------------------------------------------------------
QC_AUTO_CERTIFICATION=true
QC_MIN_SCORE_FOR_CERT=95
QC_LABORATORY_REQUIRED=false
QC_BLOCKCHAIN_RECORD=true

# -----------------------------------------------------------------------------
# IoT Sensor Integration
# -----------------------------------------------------------------------------
IOT_SENSOR_ENABLED=true
IOT_BULK_UPLOAD_MAX_RECORDS=1000
IOT_DATA_VALIDATION=true

# -----------------------------------------------------------------------------
# Food Passport Notifications
# -----------------------------------------------------------------------------
FP_NOTIFICATIONS_ENABLED=true
FP_NOTIFY_FARMER=true
FP_NOTIFY_STAKEHOLDERS=true
FP_NOTIFY_ADMINS_ON_QUALITY_FAIL=true

# -----------------------------------------------------------------------------
# Rate Limiting (Food Passport API)
# -----------------------------------------------------------------------------
FP_RATE_LIMIT_PUBLIC=100
FP_RATE_LIMIT_IOT=1000
FP_RATE_LIMIT_BLOCKCHAIN=10
FP_RATE_LIMIT_TRADING=20
FP_RATE_LIMIT_WRITE=30
