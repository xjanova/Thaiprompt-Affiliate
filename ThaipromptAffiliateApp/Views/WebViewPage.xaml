<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThaipromptAffiliateApp.Views.WebViewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A0A">

    <Grid RowDefinitions="Auto,*">

        <!-- ============================================ -->
        <!-- PREMIUM HEADER BAR -->
        <!-- ============================================ -->
        <Frame Grid.Row="0"
               Padding="0"
               CornerRadius="0"
               BorderColor="Transparent"
               HasShadow="True">
            <Frame.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.5"/>
            </Frame.Shadow>
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1A1A" Offset="0.0"/>
                    <GradientStop Color="#2A2A2A" Offset="0.5"/>
                    <GradientStop Color="#1A1A1A" Offset="1.0"/>
                </LinearGradientBrush>
            </Frame.Background>

            <Grid Padding="15,50,15,15" ColumnDefinitions="Auto,*,Auto">

                <!-- Back Button -->
                <Frame x:Name="BtnBack"
                       Grid.Column="0"
                       WidthRequest="44"
                       HeightRequest="44"
                       CornerRadius="22"
                       Padding="0"
                       BorderColor="#3A3A3A"
                       BackgroundColor="#2A2A2A">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="←"
                           FontSize="20"
                           TextColor="#D4AF37"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Title Section -->
                <VerticalStackLayout Grid.Column="1"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="2">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label x:Name="LblIcon"
                               Text="📚"
                               FontSize="18"
                               VerticalOptions="Center"/>
                        <Label x:Name="LblTitle"
                               Text="Wiki"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label x:Name="LblUrl"
                           Text="กำลังโหลด..."
                           FontSize="10"
                           TextColor="#999999"
                           HorizontalOptions="Center"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Action Button (Share/Bookmark) -->
                <Frame x:Name="BtnAction"
                       Grid.Column="2"
                       WidthRequest="44"
                       HeightRequest="44"
                       CornerRadius="22"
                       Padding="0"
                       BorderColor="#3A3A3A"
                       BackgroundColor="#2A2A2A">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnActionTapped"/>
                    </Frame.GestureRecognizers>
                    <Label x:Name="LblActionIcon"
                           Text="📤"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
            </Grid>
        </Frame>

        <!-- Gold Accent Line -->
        <BoxView Grid.Row="0"
                 HeightRequest="2"
                 VerticalOptions="End">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00D4AF37" Offset="0.0"/>
                    <GradientStop Color="#D4AF37" Offset="0.3"/>
                    <GradientStop Color="#DC143C" Offset="0.7"/>
                    <GradientStop Color="#00DC143C" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- ============================================ -->
        <!-- WEBVIEW CONTENT -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <!-- WebView -->
            <WebView x:Name="ContentWebView"
                     Navigating="OnWebViewNavigating"
                     Navigated="OnWebViewNavigated"/>

            <!-- Loading Overlay -->
            <Frame x:Name="LoadingOverlay"
                   Padding="30"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   BackgroundColor="#E0000000"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="True">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                      Color="#D4AF37"
                                      WidthRequest="50"
                                      HeightRequest="50"/>
                    <Label x:Name="LoadingText"
                           Text="กำลังโหลด..."
                           FontSize="14"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Error Overlay -->
            <Frame x:Name="ErrorOverlay"
                   Padding="30"
                   CornerRadius="20"
                   BorderColor="#DC143C"
                   BackgroundColor="#F0000000"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="False">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Label Text="⚠️"
                           FontSize="48"
                           HorizontalOptions="Center"/>
                    <Label Text="ไม่สามารถโหลดหน้าเว็บได้"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label x:Name="ErrorMessage"
                           Text="กรุณาตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
                           FontSize="12"
                           TextColor="#999999"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="ลองใหม่อีกครั้ง"
                            Clicked="OnRetryTapped"
                            BackgroundColor="#D4AF37"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="44"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Floating Bottom Actions -->
            <HorizontalStackLayout x:Name="FloatingActions"
                                  HorizontalOptions="Center"
                                  VerticalOptions="End"
                                  Spacing="15"
                                  Margin="0,0,0,30">

                <!-- Back in WebView -->
                <Frame x:Name="FabBack"
                       WidthRequest="50"
                       HeightRequest="50"
                       CornerRadius="25"
                       Padding="0"
                       BorderColor="Transparent"
                       HasShadow="True"
                       Opacity="0.5">
                    <Frame.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,3"
                                Radius="8"
                                Opacity="0.5"/>
                    </Frame.Shadow>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A2A2A" Offset="0.0"/>
                            <GradientStop Color="#1A1A1A" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWebBackTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="◀"
                           FontSize="18"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Refresh -->
                <Frame x:Name="FabRefresh"
                       WidthRequest="50"
                       HeightRequest="50"
                       CornerRadius="25"
                       Padding="0"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <Frame.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,3"
                                Radius="8"
                                Opacity="0.5"/>
                    </Frame.Shadow>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A2A2A" Offset="0.0"/>
                            <GradientStop Color="#1A1A1A" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="↻"
                           FontSize="20"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Home (Original URL) -->
                <Frame x:Name="FabHome"
                       WidthRequest="56"
                       HeightRequest="56"
                       CornerRadius="28"
                       Padding="0"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <Frame.Shadow>
                        <Shadow Brush="#D4AF37"
                                Offset="0,3"
                                Radius="10"
                                Opacity="0.4"/>
                    </Frame.Shadow>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D4AF37" Offset="0.0"/>
                            <GradientStop Color="#B8941E" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="🏠"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Forward in WebView -->
                <Frame x:Name="FabForward"
                       WidthRequest="50"
                       HeightRequest="50"
                       CornerRadius="25"
                       Padding="0"
                       BorderColor="Transparent"
                       HasShadow="True"
                       Opacity="0.5">
                    <Frame.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,3"
                                Radius="8"
                                Opacity="0.5"/>
                    </Frame.Shadow>
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A2A2A" Offset="0.0"/>
                            <GradientStop Color="#1A1A1A" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWebForwardTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="▶"
                           FontSize="18"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

            </HorizontalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
