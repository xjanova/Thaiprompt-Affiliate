<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TP.POS.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="TP.POS.App.Views.ReportsPage"
             Title="รายงาน"
             x:DataType="vm:ReportsViewModel"
             Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryGreen">#22C55E</Color>
            <Color x:Key="PrimaryBlue">#3B82F6</Color>
            <Color x:Key="DangerRed">#EF4444</Color>
            <Color x:Key="WarningAmber">#F59E0B</Color>
            <Color x:Key="LightGray">#F3F4F6</Color>
            <Color x:Key="DarkGray">#374151</Color>
            <Color x:Key="Purple">#8B5CF6</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource LightGray}">
        <ScrollView>
            <VerticalStackLayout Spacing="15" Padding="15">

                <!-- ==================== ช่วงเวลา ==================== -->
                <Border StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">
                        <!-- ปุ่มเลือกช่วงเวลา -->
                        <ScrollView Grid.Column="0" Orientation="Horizontal">
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="วันนี้"
                                        BackgroundColor="{StaticResource PrimaryGreen}"
                                        TextColor="White"
                                        FontSize="13"
                                        Padding="15,8"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="today"/>
                                <Button Text="เมื่อวาน"
                                        BackgroundColor="{StaticResource LightGray}"
                                        TextColor="{StaticResource DarkGray}"
                                        FontSize="13"
                                        Padding="15,8"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="yesterday"/>
                                <Button Text="7 วันล่าสุด"
                                        BackgroundColor="{StaticResource LightGray}"
                                        TextColor="{StaticResource DarkGray}"
                                        FontSize="13"
                                        Padding="15,8"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="week"/>
                                <Button Text="เดือนนี้"
                                        BackgroundColor="{StaticResource LightGray}"
                                        TextColor="{StaticResource DarkGray}"
                                        FontSize="13"
                                        Padding="15,8"
                                        Command="{Binding SelectPeriodCommand}"
                                        CommandParameter="month"/>
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- ปุ่มรีเฟรช -->
                        <Button Grid.Column="1"
                                Text="↻"
                                BackgroundColor="{StaticResource PrimaryBlue}"
                                TextColor="White"
                                FontSize="20"
                                WidthRequest="45"
                                HeightRequest="40"
                                Margin="10,0,0,0"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </Border>

                <!-- ==================== สรุปยอดขาย ==================== -->
                <Border StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000" Offset="0,2" Radius="8" Opacity="0.08"/>
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="20">
                        <!-- ยอดขายรวม -->
                        <VerticalStackLayout Grid.Row="0" Spacing="5" HorizontalOptions="Center">
                            <Label Text="ยอดขายรวม"
                                   FontSize="14"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding TotalSales, StringFormat='฿{0:N2}'}"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryGreen}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- สถิติย่อย -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <!-- จำนวนรายการ -->
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#EFF6FF"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="🧾"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding TransactionCount}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="รายการ"
                                       FontSize="11"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- เฉลี่ย/รายการ -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#F0FDF4"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="📈"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding AverageSale, StringFormat='฿{0:N0}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="เฉลี่ย/รายการ"
                                       FontSize="11"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- ยอดเงินสด -->
                            <VerticalStackLayout Grid.Column="2" Spacing="5">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#FEF3C7"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="💵"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding CashAmount, StringFormat='฿{0:N0}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="เงินสด"
                                       FontSize="11"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- ยอด QR/บัตร -->
                            <VerticalStackLayout Grid.Column="3" Spacing="5">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#EDE9FE"
                                        WidthRequest="45"
                                        HeightRequest="45"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label Text="💳"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding CardQrAmount, StringFormat='฿{0:N0}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="QR/บัตร"
                                       FontSize="11"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== ช่องทางชำระเงิน ==================== -->
                <Border StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="แบ่งตามช่องทางชำระเงิน"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <CollectionView ItemsSource="{Binding PaymentBreakdown}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaymentBreakdownModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="15"
                                          Padding="0,8">
                                        <!-- ไอคอน -->
                                        <Label Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="24"
                                               VerticalOptions="Center"/>

                                        <!-- ชื่อและ Progress bar -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"/>
                                            <ProgressBar Progress="{Binding Percentage, Converter={toolkit:MathExpressionConverter}, ConverterParameter='x/100'}"
                                                         ProgressColor="{StaticResource PrimaryGreen}"
                                                         HeightRequest="6"/>
                                        </VerticalStackLayout>

                                        <!-- จำนวน -->
                                        <Label Grid.Column="2"
                                               Text="{Binding Count, StringFormat='{0} รายการ'}"
                                               FontSize="12"
                                               TextColor="#6B7280"
                                               VerticalOptions="Center"/>

                                        <!-- ยอดเงิน -->
                                        <Label Grid.Column="3"
                                               Text="{Binding Amount, StringFormat='฿{0:N0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <Label Text="ไม่มีข้อมูล"
                                       FontSize="14"
                                       TextColor="#9CA3AF"
                                       HorizontalOptions="Center"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ==================== สินค้าขายดี ==================== -->
                <Border StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="🏆 สินค้าขายดี"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <CollectionView ItemsSource="{Binding TopProducts}"
                                        SelectionMode="None"
                                        HeightRequest="300">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopProductModel">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{StaticResource LightGray}"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="15">
                                            <!-- อันดับ -->
                                            <Border Grid.Column="0"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource PrimaryGreen}"
                                                    WidthRequest="30"
                                                    HeightRequest="30"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="15"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Rank}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- ชื่อสินค้า -->
                                            <Label Grid.Column="1"
                                                   Text="{Binding ProductName}"
                                                   FontSize="14"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>

                                            <!-- จำนวนที่ขาย -->
                                            <Label Grid.Column="2"
                                                   Text="{Binding QuantitySold, StringFormat='{0} ชิ้น'}"
                                                   FontSize="13"
                                                   TextColor="#6B7280"
                                                   VerticalOptions="Center"/>

                                            <!-- รายได้ -->
                                            <Label Grid.Column="3"
                                                   Text="{Binding TotalRevenue, StringFormat='฿{0:N0}'}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryGreen}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="10"
                                                     Padding="20">
                                    <Label Text="🏆" FontSize="40"/>
                                    <Label Text="ยังไม่มีข้อมูลสินค้าขายดี"
                                           FontSize="14"
                                           TextColor="#9CA3AF"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ==================== รายการขายล่าสุด ==================== -->
                <Border StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="🧾 รายการขายล่าสุด"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <CollectionView ItemsSource="{Binding RecentTransactions}"
                                        SelectionMode="None"
                                        HeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransactionDisplayModel">
                                    <Border StrokeThickness="0"
                                            BackgroundColor="{StaticResource LightGray}"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReportsViewModel}}, Path=ViewTransactionCommand}"
                                                CommandParameter="{Binding}"/>
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <!-- เลขใบเสร็จและเวลา -->
                                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="10">
                                                <Label Text="{Binding ReceiptNumber}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"/>
                                                <Label Text="{Binding PaymentMethodIcon}"
                                                       FontSize="14"/>
                                            </HorizontalStackLayout>

                                            <!-- ยอดเงิน -->
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding TotalAmount, StringFormat='฿{0:N2}'}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryGreen}"/>

                                            <!-- รายละเอียด -->
                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="15">
                                                <Label Text="{Binding TransactionDate, StringFormat='{0:HH:mm}'}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                                <Label Text="{Binding ItemCount, StringFormat='{0} รายการ'}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                            </HorizontalStackLayout>

                                            <!-- ลูกค้า -->
                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding CustomerName}"
                                                   FontSize="12"
                                                   TextColor="#9CA3AF"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="10"
                                                     Padding="20">
                                    <Label Text="🧾" FontSize="40"/>
                                    <Label Text="ยังไม่มีรายการขาย"
                                           FontSize="14"
                                           TextColor="#9CA3AF"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ปุ่มพิมพ์รายงาน -->
                <Button Text="🖨️ พิมพ์รายงาน X"
                        BackgroundColor="{StaticResource PrimaryBlue}"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50"
                        Margin="0,10,0,20"
                        Command="{Binding PrintXReportCommand}"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Border StrokeThickness="0"
                BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="White" HeightRequest="50" WidthRequest="50"/>
                <Label Text="{Binding BusyMessage}" TextColor="White" FontSize="16" Margin="0,15,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
