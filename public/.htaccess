<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Increase PHP memory limit to prevent memory exhaustion with large route files
    <IfModule mod_php.c>
        php_value memory_limit 256M
        php_value max_execution_time 60
    </IfModule>

    RewriteEngine On

    # ========================================
    # CANONICAL HOST: thaiprompt.online → main.thaiprompt.online
    # ========================================
    # Cloudflare currently has a Page Rule that 301s the bare domain to
    # `main.thaiprompt.online` BUT forgets the slash separator, producing
    # `http://main.thaiprompt.onlineapi/v1/...` (host concatenated with path).
    # See HANDOVER.md → "Cloudflare Page Rule fix" for the dashboard one-liner.
    #
    # This rule is the in-repo safety net: if the CF rule is ever removed or
    # bypassed and a request reaches Apache with HTTP_HOST=thaiprompt.online,
    # we issue a CLEAN 301 to the canonical host with the slash present.
    # When CF normally short-circuits at the edge, Apache never sees these
    # requests and this block is a no-op.
    RewriteCond %{HTTP_HOST} ^thaiprompt\.online$ [NC]
    RewriteRule ^(.*)$ https://main.thaiprompt.online/$1 [R=301,L]

    # ========================================
    # SECURITY: ป้องกันการเข้าถึงไฟล์ ENV
    # Redirect การเข้าถึง /env, /.env ไปที่หน้าแรก
    # ========================================
    # Block /.env และ /.env.* files
    RewriteRule ^\.env$ / [R=301,L]
    RewriteRule ^\.env\. / [R=301,L]
    # Block /env และ /env/ folder เท่านั้น (exact match)
    RewriteRule ^env$ / [R=301,L]
    RewriteRule ^env/ / [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
