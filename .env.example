APP_NAME="TP-Affiliate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database - MySQL (Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thaiprompt_affiliate
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache Driver (file, database, redis, memcached)
CACHE_DRIVER=file
CACHE_PREFIX=tp_affiliate_cache

# Queue (sync, database, redis, beanstalkd, sqs)
QUEUE_CONNECTION=sync

# Redis (Optional - for high performance caching)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail (Optional)
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@tp-affiliate.local"
MAIL_FROM_NAME="${APP_NAME}"

# Email Delivery System
EMAIL_DEFAULT_PROVIDER=smtp
EMAIL_TRACKING_ENABLED=true
EMAIL_TRACK_OPENS=true
EMAIL_TRACK_CLICKS=true
EMAIL_RETRY_ENABLED=true
EMAIL_MAX_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=60
EMAIL_RATE_LIMIT_ENABLED=true
EMAIL_MAX_PER_HOUR=100
EMAIL_MAX_PER_DAY=1000
EMAIL_HEALTH_CHECK_ENABLED=true
EMAIL_HEALTH_CHECK_INTERVAL=3600

# Google Gmail API (Recommended for high volume)
GMAIL_API_ENABLED=false
GMAIL_API_CREDENTIALS_PATH=storage/app/gmail-credentials.json
GMAIL_API_CREDENTIALS_JSON=
GMAIL_API_USER_EMAIL=
GMAIL_API_ACCESS_TOKEN=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_REDIRECT_URI="${APP_URL}/admin/email/gmail/callback"
GMAIL_API_FROM_EMAIL=
GMAIL_API_FROM_NAME="${APP_NAME}"
GMAIL_API_DAILY_LIMIT=500

# Google Gmail SMTP (Alternative to API - requires App Password)
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_ENCRYPTION=tls
GMAIL_SMTP_FROM_EMAIL=
GMAIL_SMTP_FROM_NAME="${APP_NAME}"
GMAIL_SMTP_DAILY_LIMIT=500
GMAIL_SMTP_HOURLY_LIMIT=100

# Generic SMTP
SMTP_ENABLED=true
SMTP_AUTH=true

# Google Translate API (Optional)
GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_TRANSLATE_CREDENTIALS=storage/app/google-credentials.json

# Translation Settings
TRANSLATE_CACHE_ENABLED=true
TRANSLATE_CACHE_TTL=86400
TRANSLATE_SOURCE_LANGUAGE=th

# Cloudflare Turnstile (Security)
CLOUDFLARE_TURNSTILE_ENABLED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_BYPASS_ADMIN=true
CLOUDFLARE_TURNSTILE_THEME=auto
CLOUDFLARE_TURNSTILE_SIZE=normal

# Turnstile Points (Enable/Disable per endpoint)
CLOUDFLARE_TURNSTILE_LOGIN=true
CLOUDFLARE_TURNSTILE_REGISTER=true
CLOUDFLARE_TURNSTILE_PASSWORD_CHANGE=true
CLOUDFLARE_TURNSTILE_PROFILE_UPDATE=true
CLOUDFLARE_TURNSTILE_WITHDRAWAL=true
CLOUDFLARE_TURNSTILE_AFFILIATE_APP=true

# Rate Limiting & Anti-Abuse
RATE_LIMITING_ENABLED=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=15
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=30
RATE_LIMIT_API_DEFAULT=60
RATE_LIMIT_API_AUTHENTICATED=120
RATE_LIMIT_API_GUEST=30
RATE_LIMIT_WITHDRAWAL_MAX_ATTEMPTS=3
RATE_LIMIT_WITHDRAWAL_DECAY_MINUTES=60
RATE_LIMIT_PASSWORD_CHANGE_MAX_ATTEMPTS=3
RATE_LIMIT_PASSWORD_CHANGE_DECAY_MINUTES=60
TRACK_FAILED_LOGINS=true
FAILED_LOGIN_RETENTION_DAYS=30

# Auto-Ban System
AUTO_BAN_ENABLED=true

# Auto-Ban Rules
AUTO_BAN_FAILED_LOGIN_ENABLED=true
AUTO_BAN_FAILED_LOGIN_THRESHOLD=10
AUTO_BAN_FAILED_LOGIN_TIME_WINDOW=30
AUTO_BAN_FAILED_LOGIN_BAN_DURATION=1440

AUTO_BAN_TURNSTILE_ENABLED=true
AUTO_BAN_TURNSTILE_THRESHOLD=15
AUTO_BAN_TURNSTILE_TIME_WINDOW=60
AUTO_BAN_TURNSTILE_BAN_DURATION=720

AUTO_BAN_RATE_LIMIT_ENABLED=true
AUTO_BAN_RATE_LIMIT_THRESHOLD=20
AUTO_BAN_RATE_LIMIT_TIME_WINDOW=60
AUTO_BAN_RATE_LIMIT_BAN_DURATION=480

AUTO_BAN_SUSPICIOUS_ENABLED=true
AUTO_BAN_SUSPICIOUS_THRESHOLD=25
AUTO_BAN_SUSPICIOUS_TIME_WINDOW=120
AUTO_BAN_SUSPICIOUS_BAN_DURATION=2880

# Auto-Ban Notifications
AUTO_BAN_NOTIFICATIONS_ENABLED=true
AUTO_BAN_EMAIL_ENABLED=true
AUTO_BAN_EMAIL_RECIPIENTS=admin@example.com
AUTO_BAN_SLACK_ENABLED=false
AUTO_BAN_SLACK_WEBHOOK=

# IP Intelligence API (Optional)
PROXYCHECK_API_KEY=
