{
  "name": "thaiprompt-affiliate",
  "version": "3.383.28",
  "description": "Thaiprompt Affiliate Mobile App - React Native + Expo",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
