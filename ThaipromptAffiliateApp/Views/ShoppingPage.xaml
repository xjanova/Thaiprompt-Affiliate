<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThaipromptAffiliateApp.Views.ShoppingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A0A">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================================ -->
        <!-- PREMIUM HEADER BAR -->
        <!-- ============================================ -->
        <Frame Grid.Row="0"
               Padding="0"
               CornerRadius="0"
               BorderColor="Transparent"
               HasShadow="True">
            <Frame.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.5"/>
            </Frame.Shadow>
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1A1A" Offset="0.0"/>
                    <GradientStop Color="#2A2A2A" Offset="0.5"/>
                    <GradientStop Color="#1A1A1A" Offset="1.0"/>
                </LinearGradientBrush>
            </Frame.Background>

            <Grid Padding="15,50,15,15" ColumnDefinitions="Auto,*,Auto">

                <!-- Back Button -->
                <Frame x:Name="BtnBack"
                       Grid.Column="0"
                       WidthRequest="44"
                       HeightRequest="44"
                       CornerRadius="22"
                       Padding="0"
                       BorderColor="#3A3A3A"
                       BackgroundColor="#2A2A2A">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Frame.GestureRecognizers>
                    <Label Text="←"
                           FontSize="20"
                           TextColor="#D4AF37"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>

                <!-- Title Section -->
                <VerticalStackLayout Grid.Column="1"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="2">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🛒"
                               FontSize="18"
                               VerticalOptions="Center"/>
                        <Label Text="ช๊อปปิ้ง"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label x:Name="LblUrl"
                           Text="กำลังโหลด..."
                           FontSize="10"
                           TextColor="#999999"
                           HorizontalOptions="Center"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Cart Badge Button -->
                <Frame x:Name="BtnCart"
                       Grid.Column="2"
                       WidthRequest="44"
                       HeightRequest="44"
                       CornerRadius="22"
                       Padding="0"
                       BorderColor="Transparent">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D4AF37" Offset="0.0"/>
                            <GradientStop Color="#B8941E" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCartTapped"/>
                    </Frame.GestureRecognizers>
                    <Grid>
                        <Label Text="🛍️"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <!-- Cart Badge -->
                        <Frame x:Name="CartBadge"
                               WidthRequest="18"
                               HeightRequest="18"
                               CornerRadius="9"
                               Padding="0"
                               BorderColor="Transparent"
                               BackgroundColor="#DC143C"
                               HorizontalOptions="End"
                               VerticalOptions="Start"
                               Margin="0,-5,-5,0"
                               IsVisible="True">
                            <Label x:Name="CartBadgeCount"
                                   Text="0"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Frame>
            </Grid>
        </Frame>

        <!-- Gold Accent Line -->
        <BoxView Grid.Row="0"
                 HeightRequest="2"
                 VerticalOptions="End">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00D4AF37" Offset="0.0"/>
                    <GradientStop Color="#D4AF37" Offset="0.3"/>
                    <GradientStop Color="#DC143C" Offset="0.7"/>
                    <GradientStop Color="#00DC143C" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- ============================================ -->
        <!-- WEBVIEW CONTENT -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <!-- WebView -->
            <WebView x:Name="ShopWebView"
                     Source="https://thaiprompt.com/shop"
                     Navigating="OnWebViewNavigating"
                     Navigated="OnWebViewNavigated"/>

            <!-- Loading Overlay -->
            <Frame x:Name="LoadingOverlay"
                   Padding="30"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   BackgroundColor="#E0000000"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="True">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                      Color="#D4AF37"
                                      WidthRequest="50"
                                      HeightRequest="50"/>
                    <Label x:Name="LoadingText"
                           Text="กำลังโหลดร้านค้า..."
                           FontSize="14"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <ProgressBar x:Name="LoadingProgress"
                                Progress="0"
                                ProgressColor="#D4AF37"
                                WidthRequest="150"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Error Overlay -->
            <Frame x:Name="ErrorOverlay"
                   Padding="30"
                   CornerRadius="20"
                   BorderColor="#DC143C"
                   BackgroundColor="#F0000000"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="False">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Label Text="⚠️"
                           FontSize="48"
                           HorizontalOptions="Center"/>
                    <Label Text="ไม่สามารถโหลดหน้าเว็บได้"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label x:Name="ErrorMessage"
                           Text="กรุณาตรวจสอบการเชื่อมต่ออินเทอร์เน็ต"
                           FontSize="12"
                           TextColor="#999999"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="ลองใหม่อีกครั้ง"
                            Clicked="OnRetryTapped"
                            BackgroundColor="#D4AF37"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="44"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- ============================================ -->
        <!-- PREMIUM BOTTOM NAVIGATION BAR -->
        <!-- ============================================ -->
        <Grid Grid.Row="2" Padding="15,10,15,25">
            <!-- Glass Background -->
            <Frame Padding="0"
                   CornerRadius="20"
                   BorderColor="Transparent"
                   HasShadow="True"
                   HeightRequest="56">
                <Frame.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,-3"
                            Radius="15"
                            Opacity="0.4"/>
                </Frame.Shadow>
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A2A2A" Offset="0.0"/>
                        <GradientStop Color="#1A1A1A" Offset="0.5"/>
                        <GradientStop Color="#0F0F0F" Offset="1.0"/>
                    </LinearGradientBrush>
                </Frame.Background>

                <Grid>
                    <!-- Top Gold Line -->
                    <BoxView HeightRequest="1"
                             VerticalOptions="Start"
                             Margin="30,0">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D4AF37" Offset="0.0"/>
                                <GradientStop Color="#D4AF37" Offset="0.5"/>
                                <GradientStop Color="#00D4AF37" Offset="1.0"/>
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Navigation Controls -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="25">

                        <!-- Back -->
                        <Frame x:Name="NavWebBack"
                               WidthRequest="42"
                               HeightRequest="42"
                               CornerRadius="21"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A"
                               Opacity="0.5">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWebBackTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="◀"
                                   FontSize="16"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Forward -->
                        <Frame x:Name="NavWebForward"
                               WidthRequest="42"
                               HeightRequest="42"
                               CornerRadius="21"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A"
                               Opacity="0.5">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWebForwardTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="▶"
                                   FontSize="16"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Refresh -->
                        <Frame x:Name="NavRefresh"
                               WidthRequest="42"
                               HeightRequest="42"
                               CornerRadius="21"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="↻"
                                   FontSize="18"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Home (Shop Home) -->
                        <Frame x:Name="NavHome"
                               WidthRequest="48"
                               HeightRequest="48"
                               CornerRadius="24"
                               Padding="0"
                               BorderColor="Transparent"
                               HasShadow="True">
                            <Frame.Shadow>
                                <Shadow Brush="#D4AF37"
                                        Offset="0,2"
                                        Radius="8"
                                        Opacity="0.4"/>
                            </Frame.Shadow>
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D4AF37" Offset="0.0"/>
                                    <GradientStop Color="#B8941E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShopHomeTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="🏠"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Search -->
                        <Frame x:Name="NavSearch"
                               WidthRequest="42"
                               HeightRequest="42"
                               CornerRadius="21"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="🔍"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Share -->
                        <Frame x:Name="NavShare"
                               WidthRequest="42"
                               HeightRequest="42"
                               CornerRadius="21"
                               Padding="0"
                               BorderColor="#3A3A3A"
                               BackgroundColor="#2A2A2A">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShareTapped"/>
                            </Frame.GestureRecognizers>
                            <Label Text="📤"
                                   FontSize="16"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                    </HorizontalStackLayout>
                </Grid>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
