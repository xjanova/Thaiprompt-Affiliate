<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ThaipromptAffiliateApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ThaipromptAffiliateApp.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="True"
    FlyoutBackgroundColor="{StaticResource Gray50}">

    <!-- Flyout Header -->
    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Grid HeightRequest="200" Background="{StaticResource PrimaryGradient}">
                <VerticalStackLayout Padding="20" VerticalOptions="Center">
                    <!-- App Logo/Icon - ใช้ Emoji Placeholder แทน Image -->
                    <Frame HeightRequest="60"
                           WidthRequest="60"
                           CornerRadius="30"
                           BackgroundColor="#FFFFFF30"
                           BorderColor="Transparent"
                           Padding="0"
                           Margin="0,0,0,10"
                           HorizontalOptions="Start">
                        <Label Text="🚀"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <!-- App Title -->
                    <Label Text="Thaiprompt Affiliate"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"/>

                    <!-- User Email (Bind to ViewModel) -->
                    <Label Text="user@example.com"
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"
                           Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>

    <!-- Flyout Footer -->
    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <Grid Padding="20" Background="{StaticResource Gray100}">
                <Label Text="Version 1.0.0"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"/>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

    <!-- Flyout Items - ใช้ FlyoutIcon แบบ FontImageSource -->
    <FlyoutItem Title="หน้าแรก">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="🏠" FontFamily="OpenSans-Regular" Size="24" Color="{StaticResource Primary}"/>
        </FlyoutItem.FlyoutIcon>
        <ShellContent Route="home" ContentTemplate="{DataTemplate local:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="แดชบอร์ด">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="📊" FontFamily="OpenSans-Regular" Size="24" Color="{StaticResource Primary}"/>
        </FlyoutItem.FlyoutIcon>
        <ShellContent Route="dashboard" ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="คอมมิชชั่น">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="💰" FontFamily="OpenSans-Regular" Size="24" Color="{StaticResource Primary}"/>
        </FlyoutItem.FlyoutIcon>
        <ShellContent Route="commissions" ContentTemplate="{DataTemplate local:CommissionsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="ผู้แนะนำ">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="👥" FontFamily="OpenSans-Regular" Size="24" Color="{StaticResource Primary}"/>
        </FlyoutItem.FlyoutIcon>
        <ShellContent Route="referrals" ContentTemplate="{DataTemplate local:ReferralsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="โปรไฟล์">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="👤" FontFamily="OpenSans-Regular" Size="24" Color="{StaticResource Primary}"/>
        </FlyoutItem.FlyoutIcon>
        <ShellContent Route="profile" ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

    <!-- Menu Items (Logout) -->
    <MenuItem Text="ออกจากระบบ"
              Clicked="OnLogoutClicked">
        <MenuItem.IconImageSource>
            <FontImageSource Glyph="🚪" FontFamily="OpenSans-Regular" Size="24" Color="{StaticResource Error}"/>
        </MenuItem.IconImageSource>
    </MenuItem>

</Shell>
