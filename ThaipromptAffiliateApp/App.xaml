<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ThaipromptAffiliateApp"
             xmlns:converters="clr-namespace:ThaipromptAffiliateApp.Converters"
             x:Class="ThaipromptAffiliateApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/PremiumColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================ -->
            <!-- VALUE CONVERTERS -->
            <!-- ============================================ -->
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:StatusToTextConverter x:Key="StatusToTextConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:CurrencyConverter x:Key="CurrencyConverter" />
            <converters:DateTimeToThaiConverter x:Key="DateTimeToThaiConverter" />
            <converters:NameToInitialConverter x:Key="NameToInitialConverter" />
            <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />

            <!-- ============================================ -->
            <!-- PREMIUM THEME COLORS - GOLD, RED, BLACK -->
            <!-- ============================================ -->

            <!-- Primary Colors - Premium Gold -->
            <Color x:Key="Primary">#D4AF37</Color>
            <Color x:Key="PrimaryDark">#B8941E</Color>
            <Color x:Key="PrimaryLight">#F1D95C</Color>

            <!-- Secondary Colors - Crimson Red -->
            <Color x:Key="Secondary">#DC143C</Color>
            <Color x:Key="SecondaryDark">#A01028</Color>
            <Color x:Key="SecondaryLight">#FF3D5C</Color>

            <!-- Accent Colors -->
            <Color x:Key="Accent">#8B5CF6</Color>
            <Color x:Key="AccentDark">#6D28D9</Color>

            <!-- Neutral Colors -->
            <Color x:Key="White">#FFFFFF</Color>
            <Color x:Key="Black">#000000</Color>

            <!-- Gray Scale -->
            <Color x:Key="Gray50">#F9FAFB</Color>
            <Color x:Key="Gray100">#F3F4F6</Color>
            <Color x:Key="Gray200">#E5E7EB</Color>
            <Color x:Key="Gray300">#D1D5DB</Color>
            <Color x:Key="Gray400">#9CA3AF</Color>
            <Color x:Key="Gray500">#6B7280</Color>
            <Color x:Key="Gray600">#4B5563</Color>
            <Color x:Key="Gray700">#374151</Color>
            <Color x:Key="Gray800">#1F2937</Color>
            <Color x:Key="Gray900">#111827</Color>

            <!-- Status Colors -->
            <Color x:Key="Error">#EF4444</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="Success">#10B981</Color>
            <Color x:Key="Info">#3B82F6</Color>

            <!-- Text Colors for Premium Dark Theme -->
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#D4AF37</Color>
            <Color x:Key="TextTertiary">#999999</Color>

            <!-- ============================================ -->
            <!-- PREMIUM GRADIENTS -->
            <!-- ============================================ -->

            <!-- Primary Gradient - Gold to Red -->
            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D4AF37" Offset="0.0" />
                <GradientStop Color="#DC143C" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Secondary Gradient -->
            <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#DC143C" Offset="0.0" />
                <GradientStop Color="#A01028" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Accent Gradient -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8B5CF6" Offset="0.0" />
                <GradientStop Color="#6D28D9" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Dark Background Gradient -->
            <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A0A0A" Offset="0.0" />
                <GradientStop Color="#1A1A1A" Offset="0.5" />
                <GradientStop Color="#0A0A0A" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Gold Glow Gradient -->
            <RadialGradientBrush x:Key="GoldGlow">
                <GradientStop Color="#D4AF37" Offset="0.0" />
                <GradientStop Color="#00000000" Offset="1.0" />
            </RadialGradientBrush>

        </ResourceDictionary>
    </Application.Resources>
</Application>
