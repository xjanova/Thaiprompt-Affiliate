<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Default Colors (will be overridden by ThemeService) -->

    <!-- Primary Colors -->
    <Color x:Key="Primary">#3B82F6</Color>
    <Color x:Key="PrimaryDark">#2563EB</Color>
    <Color x:Key="PrimaryLight">#60A5FA</Color>

    <!-- Secondary Colors -->
    <Color x:Key="Secondary">#8B5CF6</Color>
    <Color x:Key="SecondaryDark">#7C3AED</Color>
    <Color x:Key="SecondaryLight">#A78BFA</Color>

    <!-- Background Colors -->
    <Color x:Key="PageBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F9FAFB</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>

    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#111827</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- Typography Sizes -->
    <x:Double x:Key="FontSizeBase">16</x:Double>
    <x:Double x:Key="FontSizeSmall">14</x:Double>
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <x:Double x:Key="FontSizeXLarge">20</x:Double>

    <x:Double x:Key="Heading1Size">32</x:Double>
    <x:Double x:Key="Heading2Size">28</x:Double>
    <x:Double x:Key="Heading3Size">24</x:Double>
    <x:Double x:Key="Heading4Size">20</x:Double>
    <x:Double x:Key="BodySize">16</x:Double>
    <x:Double x:Key="CaptionSize">12</x:Double>

    <!-- Border Radius -->
    <x:Double x:Key="BorderRadiusSmall">4</x:Double>
    <x:Double x:Key="BorderRadiusMedium">8</x:Double>
    <x:Double x:Key="BorderRadiusLarge">16</x:Double>
    <x:Double x:Key="BorderRadiusXLarge">24</x:Double>

    <!-- Spacing -->
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>
    <x:Double x:Key="SpacingLarge">24</x:Double>
    <x:Double x:Key="SpacingXLarge">32</x:Double>

    <!-- Icon Sizes -->
    <x:Double x:Key="IconSizeSmall">16</x:Double>
    <x:Double x:Key="IconSizeMedium">24</x:Double>
    <x:Double x:Key="IconSizeLarge">32</x:Double>

    <!-- Animation Duration -->
    <x:UInt32 x:Key="AnimationDuration">300</x:UInt32>
    <x:UInt32 x:Key="TransitionFast">150</x:UInt32>
    <x:UInt32 x:Key="TransitionBase">300</x:UInt32>
    <x:UInt32 x:Key="TransitionSlow">500</x:UInt32>

    <!-- Thickness (Padding/Margin) -->
    <Thickness x:Key="PaddingSmall">8</Thickness>
    <Thickness x:Key="PaddingMedium">16</Thickness>
    <Thickness x:Key="PaddingLarge">24</Thickness>
    <Thickness x:Key="PaddingXLarge">32</Thickness>

    <Thickness x:Key="MarginSmall">8</Thickness>
    <Thickness x:Key="MarginMedium">16</Thickness>
    <Thickness x:Key="MarginLarge">24</Thickness>
    <Thickness x:Key="MarginXLarge">32</Thickness>

    <!-- Common Styles -->

    <!-- Button Styles -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadiusMedium}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingMedium}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadiusMedium}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingMedium}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    </Style>

    <!-- Label Styles -->
    <Style x:Key="Heading1" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource Heading1Size}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="Heading2" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource Heading2Size}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="Heading3" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource Heading3Size}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource CaptionSize}" />
        <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
    </Style>

    <!-- Frame/Card Styles -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource BorderColor}" />
        <Setter Property="CornerRadius" Value="{DynamicResource BorderRadiusLarge}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingMedium}" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Entry Styles -->
    <Style x:Key="StandardEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource SecondaryTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
    </Style>

</ResourceDictionary>
