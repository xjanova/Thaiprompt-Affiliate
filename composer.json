{
    "name": "xjanova/tp-affiliate",
    "description": "Thai Prompt Affiliate Marketing Platform - Modern, Professional, Ready-to-Use",
    "keywords": ["affiliate", "marketing", "laravel", "thailand", "mlm"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "bacon/bacon-qr-code": "^3.0",
        "google/cloud-translate": "^1.15",
        "google/cloud-vision": "^1.7",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^3.11",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^11.0",
        "laravel/passport": "^12.0",
        "laravel/reverb": "*",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.12",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "maatwebsite/excel": "^3.1",
        "phpmailer/phpmailer": "^6.9",
        "pragmarx/google2fa-laravel": "^2.3",
        "web3p/web3.php": "^0.1.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Migrations\\Concerns\\": "database/migrations/concerns/"
        },
        "files": [
            "app/Helpers/SeoHelper.php",
            "app/Helpers/IconHelper.php",
            "app/Helpers/CryptoHelper.php",
            "app/Helpers/SettingHelper.php",
            "app/Helpers/ActivityHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/sail",
                "nunomaduro/collision"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.30"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
